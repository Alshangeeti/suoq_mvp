# Database (Neon Postgres, auto-set by Vercel Storage integration)
DATABASE_URL=

# Admin panel password (required — /admin rejects everything without it)
ADMIN_KEY=

# Signs customer session cookies. REQUIRED IN PRODUCTION.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Bankily merchant code shown on the payment page
BANKILY_MERCHANT_CODE=

# Shared secret the Android SMS gateway must send to /api/sms-webhook
SMS_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — when both are set, OTP codes are sent for real
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Set to 0 to disable on-screen OTP codes when WhatsApp isn't configured
OTP_TEST_MODE=

# AliExpress Open Platform
ALIEXPRESS_APP_KEY=535648
ALIEXPRESS_APP_SECRET=

# Guangzhou warehouse shipping address (destination for auto-created AE orders)
GZ_WH_NAME=
GZ_WH_PHONE=
GZ_WH_PROVINCE=广东省
GZ_WH_CITY=广州市
GZ_WH_COUNTY=白云区
GZ_WH_ADDRESS=
GZ_WH_ZIP=

# Email login codes (resend.com) — test mode shows codes on screen until set
RESEND_API_KEY=
EMAIL_FROM=

# MRU per USD used for bulk-import pricing (cost x 1.2 markup)
MRU_PER_USD=40

# Set to 1 only if AE order automation becomes viable (AE cannot ship to CN/MR)
AE_AUTO_PURCHASE=
