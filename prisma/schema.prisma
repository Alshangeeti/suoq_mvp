datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id           Int     @id @default(autoincrement())
  nameAr       String
  nameFr       String
  descAr       String
  descFr       String
  priceMru     Int
  originalPriceMru Int?
  category     String
  subcategory  String?
  emoji        String
  stocked      Boolean @default(false)
  imageUrl     String?
  imagesJson   String  @default("[]")
  aliexpressId String?
  skuAttr      String?
  variantsJson String  @default("[]")
  costUsd      Float?
}

model Customer {
  id            Int      @id @default(autoincrement())
  phone         String?  @unique
  email         String?  @unique
  passwordHash  String?
  name          String?
  gender        String?
  age           Int?
  verified      Boolean  @default(false)
  cartJson      String   @default("[]")
  addressesJson String   @default("[]")
  createdAt     DateTime @default(now())
  orders        Order[]
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id                Int       @id @default(autoincrement())
  ref               String    @unique
  customerName      String
  phone             String
  city              String
  address           String
  totalMru          Int
  status            String    @default("PENDING_PAYMENT")
  paymentMethod     String    @default("BANKILY")
  paymentRef        String?
  rejectionReason   String?
  rejectionNote     String?
  aeOrderId         String?
  aeOrderError      String?
  fulfillmentStatus String    @default("RECEIVED")
  itemsJson         String
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id])
}

model AppToken {
  id           Int      @id @default(autoincrement())
  provider     String   @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  rawJson      String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model CategoryImage {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  imageUrl String
}

model Category {
  id    Int           @id @default(autoincrement())
  slug  String        @unique
  ar    String
  fr    String
  order Int           @default(0)
  subs  Subcategory[]
}

model Subcategory {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  ar         String
  fr         String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
